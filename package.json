{
  "name": "mip",
  "version": "0.1.0",
  "private": true,
  "description": "AI Market Intelligence Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "test": "vitest run packages/engine",
    "typecheck": "tsc --noEmit -p packages/engine && tsc --noEmit -p packages/shared"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
